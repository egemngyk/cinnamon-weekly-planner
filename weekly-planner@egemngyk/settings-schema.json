{
    "layout": {
        "type": "layout",
        "pages": [
            "pageGeneral",
            "pageEntries"
        ],
        "pageGeneral": {
            "type": "page",
            "title": "General",
            "sections": [
                "secAppearance",
                "secSize",
                "secColors",
                "secFrame",
                "secTitles"
            ]
        },
        "pageEntries": {
            "type": "page",
            "title": "Entries",
            "sections": [
                "secDays",
                "secContent"
            ]
        },
        "secAppearance": {
            "type": "section",
            "title": "Appearance",
            "keys": [
                "language",
                "layoutMode",
                "compact",
                "highlightToday",
                "doneStyle"
            ]
        },
        "secSize": {
            "type": "section",
            "title": "Size",
            "keys": [
                "width",
                "height",
                "fontSize",
                "uiScale"
            ]
        },
        "secColors": {
            "type": "section",
            "title": "Colors",
            "keys": [
                "bgColor",
                "textColor",
                "accentColor",
                "dayHeaderColor",
                "borderColor",
                "importantColor"
            ]
        },
        "secFrame": {
            "type": "section",
            "title": "Frame and transparency",
            "keys": [
                "opacity",
                "borderWidth",
                "borderRadius"
            ]
        },
        "secTitles": {
            "type": "section",
            "title": "Title formats",
            "keys": [
                "dateFormat",
                "headerStyle"
            ]
        },
        "secDays": {
            "type": "section",
            "title": "Visible days",
            "keys": [
                "showDay0",
                "showDay1",
                "showDay2",
                "showDay3",
                "showDay4",
                "showDay5",
                "showDay6"
            ]
        },
        "secContent": {
            "type": "section",
            "title": "Content",
            "keys": [
                "showNotes",
                "showCheckbox",
                "showStar"
            ]
        }
    },
    "language": {
        "type": "combobox",
        "default": "en",
        "description": "Language",
        "tooltip": "Language of the desklet interface (week titles, buttons and dialogs)",
        "options": {
            "English": "en",
            "Turkish": "tr"
        }
    },
    "layoutMode": {
        "type": "combobox",
        "default": "columns",
        "description": "Layout",
        "options": {
            "Vertical columns (7 columns)": "columns",
            "Horizontal rows (7 rows)": "rows"
        }
    },
    "compact": {
        "type": "switch",
        "default": false,
        "description": "Compact view"
    },
    "highlightToday": {
        "type": "switch",
        "default": true,
        "description": "Highlight today"
    },
    "doneStyle": {
        "type": "combobox",
        "default": "both",
        "description": "Completed task style",
        "options": {
            "Strikethrough": "strike",
            "Dimmed": "dim",
            "Strikethrough and dimmed": "both"
        }
    },
    "width": {
        "type": "spinbutton",
        "default": 620,
        "min": 240,
        "max": 2400,
        "step": 10,
        "units": "px",
        "description": "Width"
    },
    "height": {
        "type": "spinbutton",
        "default": 420,
        "min": 160,
        "max": 1600,
        "step": 10,
        "units": "px",
        "description": "Height"
    },
    "fontSize": {
        "type": "spinbutton",
        "default": 12,
        "min": 8,
        "max": 28,
        "step": 1,
        "units": "px",
        "description": "Font size"
    },
    "uiScale": {
        "type": "combobox",
        "default": 100,
        "description": "UI scale",
        "options": {
            "%75": 75,
            "%90": 90,
            "%100": 100,
            "%110": 110,
            "%125": 125,
            "%150": 150,
            "%175": 175,
            "%200": 200
        }
    },
    "bgColor": {
        "type": "colorchooser",
        "default": "rgb(28,30,36)",
        "description": "Background color"
    },
    "textColor": {
        "type": "colorchooser",
        "default": "rgb(236,238,242)",
        "description": "Text color"
    },
    "accentColor": {
        "type": "colorchooser",
        "default": "rgb(79,157,222)",
        "description": "Accent color"
    },
    "dayHeaderColor": {
        "type": "colorchooser",
        "default": "rgb(170,180,200)",
        "description": "Day header color"
    },
    "borderColor": {
        "type": "colorchooser",
        "default": "rgb(70,76,90)",
        "description": "Border color"
    },
    "importantColor": {
        "type": "colorchooser",
        "default": "rgb(255,196,60)",
        "description": "Important entry highlight"
    },
    "opacity": {
        "type": "scale",
        "default": 92,
        "min": 10,
        "max": 100,
        "step": 1,
        "description": "Background opacity (%)"
    },
    "borderWidth": {
        "type": "spinbutton",
        "default": 1,
        "min": 0,
        "max": 8,
        "step": 1,
        "units": "px",
        "description": "Border width"
    },
    "borderRadius": {
        "type": "spinbutton",
        "default": 10,
        "min": 0,
        "max": 40,
        "step": 1,
        "units": "px",
        "description": "Corner radius"
    },
    "dateFormat": {
        "type": "combobox",
        "default": "long",
        "description": "Week range format",
        "options": {
            "November 2–8, 2026": "long",
            "Nov 2–8, 2026": "short",
            "11/02/2026 – 11/08/2026": "numeric"
        }
    },
    "headerStyle": {
        "type": "combobox",
        "default": "full",
        "description": "Day header format",
        "options": {
            "Day name + date (Monday, Nov 2)": "full",
            "Short name + day number (Mon 2)": "short",
            "Day name only": "name",
            "Date only (11/02)": "date"
        }
    },
    "showDay0": {
        "type": "switch",
        "default": true,
        "description": "Show Monday"
    },
    "showDay1": {
        "type": "switch",
        "default": true,
        "description": "Show Tuesday"
    },
    "showDay2": {
        "type": "switch",
        "default": true,
        "description": "Show Wednesday"
    },
    "showDay3": {
        "type": "switch",
        "default": true,
        "description": "Show Thursday"
    },
    "showDay4": {
        "type": "switch",
        "default": true,
        "description": "Show Friday"
    },
    "showDay5": {
        "type": "switch",
        "default": true,
        "description": "Show Saturday"
    },
    "showDay6": {
        "type": "switch",
        "default": true,
        "description": "Show Sunday"
    },
    "showNotes": {
        "type": "switch",
        "default": true,
        "description": "Show notes preview"
    },
    "showCheckbox": {
        "type": "switch",
        "default": true,
        "description": "Show completion checkbox on to-do entries"
    },
    "showStar": {
        "type": "switch",
        "default": true,
        "description": "Show ★ on important entries"
    }
}