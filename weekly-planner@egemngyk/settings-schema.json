{
    "layout": {
        "type": "layout",
        "pages": [
            "pageGeneral",
            "pageEntries"
        ],
        "pageGeneral": {
            "type": "page",
            "title": "General",
            "sections": [
                "secAppearance",
                "secSize",
                "secColors",
                "secFrame",
                "secTitles"
            ]
        },
        "pageEntries": {
            "type": "page",
            "title": "Entries",
            "sections": [
                "secMode",
                "secWeek",
                "secContent",
                "secDay0",
                "secDay1",
                "secDay2",
                "secDay3",
                "secDay4",
                "secDay5",
                "secDay6"
            ]
        },
        "secAppearance": {
            "type": "section",
            "title": "Appearance",
            "keys": [
                "language",
                "layoutMode",
                "compact",
                "highlightToday",
                "doneStyle"
            ]
        },
        "secSize": {
            "type": "section",
            "title": "Size",
            "keys": [
                "width",
                "height",
                "fontSize",
                "uiScale"
            ]
        },
        "secColors": {
            "type": "section",
            "title": "Colors",
            "keys": [
                "bgColor",
                "textColor",
                "accentColor",
                "dayHeaderColor",
                "borderColor",
                "importantColor"
            ]
        },
        "secFrame": {
            "type": "section",
            "title": "Frame and transparency",
            "keys": [
                "opacity",
                "borderWidth",
                "borderRadius"
            ]
        },
        "secTitles": {
            "type": "section",
            "title": "Title formats",
            "keys": [
                "dateFormat",
                "headerStyle"
            ]
        },
        "secMode": {
            "type": "section",
            "title": "Entries — mode",
            "keys": [
                "weeklyMode"
            ]
        },
        "secWeek": {
            "type": "section",
            "title": "Week being edited",
            "dependency": "!weeklyMode",
            "keys": [
                "weekInfo",
                "weekDate",
                "weekGo",
                "weekPrev",
                "weekNext",
                "weekToday"
            ]
        },
        "secContent": {
            "type": "section",
            "title": "Content",
            "keys": [
                "showNotes",
                "showCheckbox",
                "showStar"
            ]
        },
        "secDay0": {
            "type": "section",
            "title": "Monday",
            "keys": [
                "showDay0",
                "weeklyItems0",
                "weekItems0"
            ]
        },
        "secDay1": {
            "type": "section",
            "title": "Tuesday",
            "keys": [
                "showDay1",
                "weeklyItems1",
                "weekItems1"
            ]
        },
        "secDay2": {
            "type": "section",
            "title": "Wednesday",
            "keys": [
                "showDay2",
                "weeklyItems2",
                "weekItems2"
            ]
        },
        "secDay3": {
            "type": "section",
            "title": "Thursday",
            "keys": [
                "showDay3",
                "weeklyItems3",
                "weekItems3"
            ]
        },
        "secDay4": {
            "type": "section",
            "title": "Friday",
            "keys": [
                "showDay4",
                "weeklyItems4",
                "weekItems4"
            ]
        },
        "secDay5": {
            "type": "section",
            "title": "Saturday",
            "keys": [
                "showDay5",
                "weeklyItems5",
                "weekItems5"
            ]
        },
        "secDay6": {
            "type": "section",
            "title": "Sunday",
            "keys": [
                "showDay6",
                "weeklyItems6",
                "weekItems6"
            ]
        }
    },
    "language": {
        "type": "combobox",
        "default": "en",
        "description": "Language",
        "tooltip": "Language of the desklet interface (week titles, buttons and dialogs)",
        "options": {
            "English": "en",
            "Turkish": "tr"
        }
    },
    "layoutMode": {
        "type": "combobox",
        "default": "columns",
        "description": "Layout",
        "options": {
            "Vertical columns (7 columns)": "columns",
            "Horizontal rows (7 rows)": "rows"
        }
    },
    "compact": {
        "type": "switch",
        "default": false,
        "description": "Compact view"
    },
    "highlightToday": {
        "type": "switch",
        "default": true,
        "description": "Highlight today"
    },
    "doneStyle": {
        "type": "combobox",
        "default": "both",
        "description": "Completed task style",
        "options": {
            "Strikethrough": "strike",
            "Dimmed": "dim",
            "Strikethrough and dimmed": "both"
        }
    },
    "width": {
        "type": "spinbutton",
        "default": 620,
        "min": 240,
        "max": 2400,
        "step": 10,
        "units": "px",
        "description": "Width"
    },
    "height": {
        "type": "spinbutton",
        "default": 420,
        "min": 160,
        "max": 1600,
        "step": 10,
        "units": "px",
        "description": "Height"
    },
    "fontSize": {
        "type": "spinbutton",
        "default": 12,
        "min": 8,
        "max": 28,
        "step": 1,
        "units": "px",
        "description": "Font size"
    },
    "uiScale": {
        "type": "combobox",
        "default": 100,
        "description": "UI scale",
        "options": {
            "%75": 75,
            "%90": 90,
            "%100": 100,
            "%110": 110,
            "%125": 125,
            "%150": 150,
            "%175": 175,
            "%200": 200
        }
    },
    "bgColor": {
        "type": "colorchooser",
        "default": "rgb(28,30,36)",
        "description": "Background color"
    },
    "textColor": {
        "type": "colorchooser",
        "default": "rgb(236,238,242)",
        "description": "Text color"
    },
    "accentColor": {
        "type": "colorchooser",
        "default": "rgb(79,157,222)",
        "description": "Accent color"
    },
    "dayHeaderColor": {
        "type": "colorchooser",
        "default": "rgb(170,180,200)",
        "description": "Day header color"
    },
    "borderColor": {
        "type": "colorchooser",
        "default": "rgb(70,76,90)",
        "description": "Border color"
    },
    "importantColor": {
        "type": "colorchooser",
        "default": "rgb(255,196,60)",
        "description": "Important entry highlight"
    },
    "opacity": {
        "type": "scale",
        "default": 92,
        "min": 10,
        "max": 100,
        "step": 1,
        "description": "Background opacity (%)"
    },
    "borderWidth": {
        "type": "spinbutton",
        "default": 1,
        "min": 0,
        "max": 8,
        "step": 1,
        "units": "px",
        "description": "Border width"
    },
    "borderRadius": {
        "type": "spinbutton",
        "default": 10,
        "min": 0,
        "max": 40,
        "step": 1,
        "units": "px",
        "description": "Corner radius"
    },
    "dateFormat": {
        "type": "combobox",
        "default": "long",
        "description": "Week range format",
        "options": {
            "November 2–8, 2026": "long",
            "Nov 2–8, 2026": "short",
            "11/02/2026 – 11/08/2026": "numeric"
        }
    },
    "headerStyle": {
        "type": "combobox",
        "default": "full",
        "description": "Day header format",
        "options": {
            "Day name + date (Monday, Nov 2)": "full",
            "Short name + day number (Mon 2)": "short",
            "Day name only": "name",
            "Date only (11/02)": "date"
        }
    },
    "weeklyMode": {
        "type": "switch",
        "default": true,
        "description": "Repeat every week",
        "tooltip": "On: the lists below hold entries that repeat every week on the same weekday. Off: the lists hold entries of one specific week only (choose the week with the buttons below)."
    },
    "weekInfo": {
        "type": "entry",
        "default": "",
        "description": "Week",
        "tooltip": "The week whose entries are shown in the lists below (updated automatically).",
        "dependency": "!weeklyMode"
    },
    "weekDate": {
        "type": "entry",
        "default": "",
        "description": "Go to date (YYYY-MM-DD)",
        "tooltip": "Type any date, then press the button below to jump to the week that contains it.",
        "dependency": "!weeklyMode"
    },
    "weekGo": {
        "type": "button",
        "description": "Save and go to the date above",
        "callback": "onWeekGo",
        "tooltip": "Changes are saved automatically; this opens the week of the date above.",
        "dependency": "!weeklyMode"
    },
    "weekPrev": {
        "type": "button",
        "description": "‹ Previous week",
        "callback": "onWeekPrev",
        "dependency": "!weeklyMode"
    },
    "weekNext": {
        "type": "button",
        "description": "Next week ›",
        "callback": "onWeekNext",
        "dependency": "!weeklyMode"
    },
    "weekToday": {
        "type": "button",
        "description": "This week",
        "callback": "onWeekToday",
        "dependency": "!weeklyMode"
    },
    "showNotes": {
        "type": "switch",
        "default": true,
        "description": "Show notes preview"
    },
    "showCheckbox": {
        "type": "switch",
        "default": true,
        "description": "Show completion checkbox on to-do entries"
    },
    "showStar": {
        "type": "switch",
        "default": true,
        "description": "Show ★ on important entries"
    },
    "showDay0": {
        "type": "switch",
        "default": true,
        "description": "Show Monday"
    },
    "weeklyItems0": {
        "type": "list",
        "default": [],
        "description": "Monday — every week",
        "tooltip": "Color: blue, red, yellow, purple, teal, gray, pink, green, orange, navy (or #rrggbb); empty = default color. To-do entries get a completion checkbox.",
        "columns": [
            {
                "id": "title",
                "title": "Title",
                "type": "string",
                "default": "New entry"
            },
            {
                "id": "notes",
                "title": "Notes",
                "type": "string",
                "default": ""
            },
            {
                "id": "todo",
                "title": "To-do",
                "type": "boolean",
                "default": false
            },
            {
                "id": "important",
                "title": "Important",
                "type": "boolean",
                "default": false
            },
            {
                "id": "color",
                "title": "Color",
                "type": "string",
                "options": {
                    "(default)": "",
                    "🔴 Red": "#e5534b",
                    "🟠 Orange": "#e67e22",
                    "🟡 Amber": "#e0a030",
                    "🟡 Yellow": "#f1c40f",
                    "🟢 Green": "#6ab04c",
                    "🩵 Teal": "#3fb0a0",
                    "🔵 Blue": "#4f9dde",
                    "🔵 Navy": "#2c6fbb",
                    "🟣 Purple": "#8e6ad8",
                    "🩷 Pink": "#d9609a",
                    "🟤 Brown": "#a0522d",
                    "⚪ Gray": "#7f8c9a"
                },
                "default": ""
            }
        ],
        "dependency": "weeklyMode"
    },
